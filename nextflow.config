process {

  executor = "slurm"
  clusterOptions = "--account=nn10082k"
  queue = "normal"

  // You may modify this label to match your compute resource
  withLabel: "require_gpu" {
    clusterOptions = "--account=nn10082k --gpus=1"
    queue = "a100"
    cpus = 8
  }

  // You may modify this label to match your compute resource
  withLabel: "high_mem_per_cpu" {
    queue = "bigmem"
  }

  // Do not modify this label unless you are certain what you are doing
  withLabel: "require_pipefail" {
    shell = ["/bin/bash", "-euo", "pipefail"]
  }
  
}

singularity {

  enabled = true
  autoMounts = true
  cacheDir = "work/containers"

}

executor.queueSize = 250
report.overwrite = true
